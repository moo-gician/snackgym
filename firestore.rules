rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // [ARCHIVED 2026-11-20] Project sunset — all read/write locked to prevent billing/abuse.
    match /{document=**} {
      allow read, write: if false;
    }

    /* Original active rules (kept for archive reference):
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /daily_workout_sessions/{docId} {
      allow read, write: if request.auth != null && docId.matches(request.auth.uid + '_.*');
    }
    */
  }
}